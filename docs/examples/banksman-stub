#!/bin/sh
# A stand-in for banksman in the tests of a project's scripts. Put it on PATH as `banksman`.
#
# It appends each call to the file that BANKSMAN_STUB_LOG names, one line for each call. acquire
# prints a grant of the resource stub-0 with the lease stub-lease and the serial stub-serial, or
# keeps the lease that --lease names, or exits with BANKSMAN_STUB_STATUS, for example 4 for a
# machine whose devices are all in use. run runs the command after -- as banksman run --lease
# runs it for a device: with the serial stub-serial in BANKSMAN_SERIAL, BANKSMAN_SERIALS, and
# ANDROID_SERIAL, with the resource stub-0, or the one that --resource names, in
# BANKSMAN_RESOURCE and BANKSMAN_RESOURCES, with the lease stub-lease, or the one that --lease
# names, in BANKSMAN_LEASE, also for --holding, and with each argument {serial}, {resource},
# {serials}, and {resources} replaced. Every other command does nothing.

if [ -n "${BANKSMAN_STUB_LOG:-}" ]; then
    printf '%s\n' "$*" >>"$BANKSMAN_STUB_LOG"
fi
case $1 in
    acquire)
        if [ -n "${BANKSMAN_STUB_STATUS:-}" ]; then
            exit "$BANKSMAN_STUB_STATUS"
        fi
        lease=stub-lease
        kept=false
        previous=${BANKSMAN_STUB_PREVIOUS:-other}
        while [ "$#" -gt 0 ]; do
            if [ "$1" = --lease ]; then
                lease=$2
                kept=true
                previous=self
            fi
            shift
        done
        printf 'RESOURCE=stub-0\nKIND=stub\nLEASE=%s\nSTATE=ready\nKEPT=%s\n' "$lease" "$kept"
        printf 'PREVIOUS=%s\n' "$previous"
        printf 'SERIAL=stub-serial\n'
        ;;
    run)
        shift
        unset BANKSMAN_ACCOUNTS
        export BANKSMAN_KIND=stub BANKSMAN_SERIAL=stub-serial ANDROID_SERIAL=stub-serial
        export BANKSMAN_SERIALS=stub-serial BANKSMAN_RESOURCE=stub-0 BANKSMAN_LEASE=stub-lease
        while [ "$#" -gt 0 ]; do
            case $1 in
                --resource) BANKSMAN_RESOURCE=$2 ;;
                --lease) BANKSMAN_LEASE=$2 ;;
                --)
                    shift
                    break
                    ;;
            esac
            shift
        done
        export BANKSMAN_RESOURCES="$BANKSMAN_RESOURCE"
        # Only a whole argument is replaced, as banksman run does.
        for argument; do
            shift
            case $argument in
                '{serial}' | '{serials}') set -- "$@" stub-serial ;;
                '{resource}' | '{resources}') set -- "$@" "$BANKSMAN_RESOURCE" ;;
                *) set -- "$@" "$argument" ;;
            esac
        done
        exec "$@"
        ;;
esac

